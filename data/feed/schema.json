{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/duanjiangDJ/ai-model-pricing/main/data/feed/schema.json",
  "title": "AI Model Pricing Database Schema",
  "description": "Versioned machine-readable schema for the ai-model-pricing database. Validates: index.json, providers/*.json, plans.json, resellers.json, manifest.json, changelog.json",
  "version": "26.7.14",
  "$defs": {
    "channel": {
      "type": "string",
      "enum": [
        "first_party",
        "cloud",
        "hosted",
        "aggregator",
        "reseller",
        "subscription"
      ]
    },
    "providerCategory": {
      "type": "string",
      "enum": [
        "ai_vendor",
        "cloud_platform",
        "inference_host",
        "aggregator",
        "reseller",
        "gpu_cloud"
      ]
    },
    "modelCategory": {
      "type": "string",
      "enum": [
        "chat",
        "reasoning",
        "embedding",
        "image_gen",
        "video_gen",
        "audio_tts",
        "audio_stt",
        "audio_understanding",
        "realtime",
        "rerank",
        "moderation",
        "code",
        "translation",
        "vision",
        "music_gen",
        "multimodal"
      ]
    },
    "priceType": {
      "type": "string",
      "enum": [
        "per_mtok",
        "cache_read",
        "cache_write",
        "batch",
        "per_image",
        "subscription_monthly",
        "subscription_yearly",
        "free_tier"
      ]
    },
    "planCategory": {
      "type": "string",
      "enum": [
        "consumer",
        "coding",
        "team",
        "enterprise",
        "student",
        "api_credits",
        "free"
      ]
    },
    "mtokPricing": {
      "type": "object",
      "description": "Per-token price (in up to two currencies, usd/cny). null = not offered/unknown (never 0).",
      "properties": {
        "input": {
          "$ref": "#/$defs/dualPrice"
        },
        "output": {
          "$ref": "#/$defs/dualPrice"
        },
        "cache_read": {
          "$ref": "#/$defs/dualPrice"
        },
        "cache_write": {
          "$ref": "#/$defs/dualPrice"
        },
        "reasoning_effort": {
          "type": [
            "array",
            "null"
          ],
          "description": "Some models price output by reasoning effort tier.",
          "items": {
            "type": "object",
            "properties": {
              "effort": {
                "type": "string"
              },
              "input": {
                "$ref": "#/$defs/dualPrice"
              },
              "output": {
                "$ref": "#/$defs/dualPrice"
              }
            },
            "required": [
              "effort",
              "input",
              "output"
            ]
          }
        }
      },
      "required": [
        "input",
        "output"
      ]
    },
    "modelPricing": {
      "type": "object",
      "description": "All price types for one model. Every field optional; at least one non-null.",
      "properties": {
        "per_mtok": {
          "$ref": "#/$defs/mtokPricing"
        },
        "batch": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "input": {
              "$ref": "#/$defs/dualPrice"
            },
            "output": {
              "$ref": "#/$defs/dualPrice"
            }
          }
        },
        "per_image": {
          "type": [
            "array",
            "null"
          ],
          "description": "Tiers for image models.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "price": {
                "$ref": "#/$defs/dualPrice"
              }
            },
            "required": [
              "name",
              "price"
            ]
          }
        },
        "promo": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "list_price": {
              "type": "object",
              "description": "Strikethrough/list price before the promo discount (per_mtok shape: {input, output, cache_read})."
            },
            "ends_at": {
              "type": [
                "string",
                "null"
              ],
              "description": "Promo expiry timestamp (UTC ISO)."
            }
          },
          "description": "Temporary promotion: the current per_mtok values are the discounted price; list_price holds the pre-promo price."
        }
      },
      "minProperties": 1
    },
    "modelStatus": {
      "type": "string",
      "enum": [
        "online",
        "offline"
      ],
      "description": "online = currently sold/available; offline = not available (retired/deprecated/superseded — the reason stays in notes)."
    },
    "model": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable machine id, e.g. 'gpt-4o' or 'openai/gpt-4o' for aggregator files"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/modelCategory"
        },
        "status": {
          "$ref": "#/$defs/modelStatus"
        },
        "modalities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "text",
              "image_in",
              "image_out",
              "audio_in",
              "audio_out",
              "video_in",
              "video_out"
            ]
          }
        },
        "context_window": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "max_output": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "pricing": {
          "$ref": "#/$defs/modelPricing"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "billing_model": {
          "$ref": "#/$defs/billingModel"
        }
      },
      "required": [
        "id",
        "name",
        "category",
        "pricing"
      ]
    },
    "provider": {
      "type": "object",
      "properties": {
        "provider_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "channel": {
          "$ref": "#/$defs/channel"
        },
        "category": {
          "$ref": "#/$defs/providerCategory"
        },
        "region": {
          "type": "string",
          "enum": [
            "global",
            "cn",
            "us",
            "eu",
            "other"
          ]
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "pricing_page": {
          "type": [
            "string",
            "null"
          ]
        },
        "api_base_url": {
          "type": [
            "string",
            "null"
          ],
          "description": "The API endpoint this provider serves (e.g. https://api.deepseek.com). null = subscription product without a public API. Canonical identity for deduplication: providers sharing the same base URL expose the same API; their model entries must be merged."
        },
        "currency": {
          "type": "string",
          "default": "USD"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "models": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/model"
          }
        }
      },
      "required": [
        "provider_id",
        "name",
        "channel",
        "category",
        "currency",
        "updated_at",
        "models"
      ]
    },
    "planPricingModel": {
      "type": "string",
      "enum": [
        "flat_monthly",
        "flat_yearly",
        "per_seat_monthly",
        "per_seat_yearly",
        "credits",
        "usage_included",
        "free",
        "custom"
      ],
      "description": "Subscription billing structure, distinct from per-token model pricing. flat_* = fixed price for the plan; per_seat_* = price per user; credits = prepaid points/credits; usage_included = plan bundles usage (no standalone price); free = free plan; custom = contact sales."
    },
    "plan": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "provider_id": {
          "type": "string"
        },
        "product": {
          "type": "string",
          "description": "e.g. 'ChatGPT', 'Claude Code', 'Cursor'"
        },
        "plan": {
          "type": "string",
          "description": "e.g. 'Plus', 'Pro', 'Ultra'"
        },
        "category": {
          "$ref": "#/$defs/planCategory"
        },
        "pricing_model": {
          "$ref": "#/$defs/planPricingModel"
        },
        "billing": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "monthly",
            "yearly",
            "one_time",
            null
          ]
        },
        "price_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Yearly plans: total yearly price; per-seat plans: price per seat. null = free plan or custom."
        },
        "price_per_seat_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "For per_seat_* models: price per user (monthly or yearly per billing)."
        },
        "credits_included": {
          "type": [
            "object",
            "null"
          ],
          "description": "For credits/usage_included plans: what the subscription bundles.",
          "properties": {
            "unit_name": {
              "type": "string",
              "description": "e.g. 'AI credits', 'points', 'requests'"
            },
            "amount": {
              "type": [
                "number",
                "null"
              ],
              "description": "Monthly included amount"
            },
            "renewal": {
              "type": "string",
              "enum": [
                "monthly",
                "yearly",
                "one_time",
                null
              ]
            }
          }
        },
        "included_models": {
          "type": [
            "array",
            "null"
          ],
          "description": "Models available within this plan without per-token charge (subscription-included).",
          "items": {
            "type": "string",
            "description": "model id as referenced in the provider file"
          }
        },
        "price_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "limits": {
          "type": [
            "string",
            "null"
          ],
          "description": "Usage limits in human terms"
        },
        "includes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "provider_id",
        "product",
        "plan",
        "category",
        "price_usd",
        "verified_at"
      ]
    },
    "indexEntry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "channel": {
          "$ref": "#/$defs/channel"
        },
        "model_count": {
          "type": "integer",
          "minimum": 0
        },
        "file": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "name",
        "channel",
        "model_count",
        "file",
        "updated_at"
      ]
    },
    "changelogEntry": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "type": "string",
          "enum": [
            "add",
            "update",
            "remove",
            "verify"
          ]
        },
        "scope": {
          "type": "string",
          "enum": [
            "provider",
            "model",
            "plan",
            "reseller",
            "meta"
          ]
        },
        "provider_id": {
          "type": "string"
        },
        "item_id": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "old": {},
        "new": {},
        "source": {
          "type": "string"
        }
      },
      "required": [
        "date",
        "kind",
        "scope",
        "provider_id",
        "item_id"
      ]
    },
    "billingModel": {
      "type": "array",
      "items": {
        "enum": [
          "pay_per_token",
          "pay_per_image",
          "subscription_included",
          "credits",
          "free",
          "unknown"
        ]
      },
      "minItems": 1,
      "description": "How this model is billed. An array because one model can have multiple billing methods (e.g. free tier + pay-per-token). Values: pay_per_token (per-token API incl. cache/batch), pay_per_image, subscription_included (included in a subscription/coding plan), credits (points-based systems), free (no cost), unknown (not yet determined)."
    },
    "dualPrice": {
      "type": [
        "object",
        "null"
      ],
      "description": "A price in up to two currencies. At least one of usd/cny present (a model may be priced in just one currency by the vendor). null = not offered/unknown (never misinterpreted as 0).",
      "properties": {
        "usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "USD price (official USD page or vendor's USD rate)."
        },
        "cny": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "CNY price (official CNY page / domestic pricing)."
        }
      },
      "minProperties": 1
    }
  },
  "providerFile": {
    "$ref": "#/$defs/provider"
  },
  "plansFile": {
    "type": "object",
    "properties": {
      "schema_version": {
        "type": "string",
        "const": "26.7.14"
      },
      "updated_at": {
        "type": "string",
        "format": "date-time"
      },
      "plans": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/plan"
        }
      }
    },
    "required": [
      "schema_version",
      "updated_at",
      "plans"
    ]
  },
  "indexFile": {
    "type": "object",
    "properties": {
      "schema_version": {
        "type": "string",
        "const": "26.7.14"
      },
      "generated_at": {
        "type": "string",
        "format": "date-time"
      },
      "currency": {
        "type": "string",
        "const": "USD"
      },
      "provider_count": {
        "type": "integer"
      },
      "model_count": {
        "type": "integer"
      },
      "plan_count": {
        "type": "integer"
      },
      "providers": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/indexEntry"
        }
      },
      "resellers": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/indexEntry"
        }
      }
    },
    "required": [
      "schema_version",
      "generated_at",
      "currency",
      "provider_count",
      "model_count",
      "plan_count",
      "providers",
      "resellers"
    ]
  },
  "manifestFile": {
    "type": "object",
    "properties": {
      "schema_version": {
        "type": "string",
        "const": "26.7.14"
      },
      "last_full_sync": {
        "type": "string",
        "format": "date-time"
      },
      "last_daily_check": {
        "type": "string",
        "format": "date-time"
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "url": {
              "type": "string",
              "format": "uri"
            },
            "auto_sync": {
              "type": "boolean"
            },
            "last_ok": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "last_error": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "name",
            "url",
            "auto_sync"
          ]
        }
      },
      "coverage": {
        "type": "object",
        "additionalProperties": {
          "type": "integer"
        }
      }
    },
    "required": [
      "schema_version",
      "sources"
    ]
  },
  "changelogFile": {
    "type": "object",
    "properties": {
      "schema_version": {
        "type": "string",
        "const": "26.7.14"
      },
      "entries": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/changelogEntry"
        }
      }
    },
    "required": [
      "schema_version",
      "entries"
    ]
  }
}
